# ==============================================================================
# SHOPKART - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development. Never commit production secrets.

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL 17 - Port 5433 on host per docker-compose.yml)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://shopkart_admin:replace_with_your_local_password@localhost:5433/shopkart"
POSTGRES_PASSWORD=replace_with_your_local_password

# ------------------------------------------------------------------------------
# CACHE & SESSION STORE (Redis 7 - Port 6379 on host per docker-compose.yml)
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# AUTH MICROSERVICE (NestJS)
# ------------------------------------------------------------------------------
AUTH_SERVICE_PORT=3001
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_placeholder
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_placeholder
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"
COOKIE_SECRET=optional_cookie_secret_for_signed_cookies

# One-time superadmin bootstrap (npm run bootstrap:superadmin -w auth-service).
# Set these only while provisioning, then remove SUPERADMIN_PASSWORD. Never commit real values.
# SUPERADMIN_EMAIL=
# SUPERADMIN_PASSWORD=
# SUPERADMIN_NAME=

# ------------------------------------------------------------------------------
# STOREFRONT WEB APPLICATION (Next.js)
# ------------------------------------------------------------------------------
PORT=3000
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"
NODE_ENV=development

# ------------------------------------------------------------------------------
# CATALOG MICROSERVICE (NestJS)
# ------------------------------------------------------------------------------
CATALOG_SERVICE_PORT=3020
NEXT_PUBLIC_CATALOG_API_URL="http://localhost:3020"
CATALOG_UPLOAD_DIR="storage/product-images"

# ------------------------------------------------------------------------------
# CART MICROSERVICE (NestJS)
# ------------------------------------------------------------------------------
CART_SERVICE_PORT=3030
NEXT_PUBLIC_CART_API_URL="http://localhost:3030"
CATALOG_API_URL="http://localhost:3020"

# ------------------------------------------------------------------------------
# ORDER MICROSERVICE (NestJS)
# ------------------------------------------------------------------------------
ORDER_SERVICE_PORT=3040
NEXT_PUBLIC_ORDER_API_URL="http://localhost:3040"

# ------------------------------------------------------------------------------
# NOTIFICATION MICROSERVICE (NestJS)
# ------------------------------------------------------------------------------
NOTIFICATION_SERVICE_PORT=3050
NOTIFICATION_SERVICE_URL="http://localhost:3050"
NEXT_PUBLIC_NOTIFICATION_API_URL="http://localhost:3050"
NOTIFICATION_INTERNAL_API_KEY="replace_with_a_strong_random_secret"

# Email / SMTP Configuration (e.g. Mailpit on 1025 or real SMTP)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="\"Shopkart\" <no-reply@shopkart.com>"
