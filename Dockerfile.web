
FROM node:22-bookworm-slim

WORKDIR /app

# Copy project files
COPY . .

# Install dependencies
RUN npm ci

# Build shared package
RUN npm run build --workspace=@shopkart/common

# Public API URLs are inlined into the client bundle at build time,
# so they must be supplied as build args (see .env.example).
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_CATALOG_API_URL
ARG NEXT_PUBLIC_CART_API_URL
ARG NEXT_PUBLIC_ORDER_API_URL
ARG NEXT_PUBLIC_NOTIFICATION_API_URL

# Internal service URLs used by Next.js rewrites and SSR proxying
ARG INTERNAL_AUTH_URL
ARG INTERNAL_CATALOG_URL
ARG INTERNAL_CART_URL
ARG INTERNAL_ORDER_URL
ARG INTERNAL_NOTIFICATION_URL

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_CATALOG_API_URL=$NEXT_PUBLIC_CATALOG_API_URL \
    NEXT_PUBLIC_CART_API_URL=$NEXT_PUBLIC_CART_API_URL \
    NEXT_PUBLIC_ORDER_API_URL=$NEXT_PUBLIC_ORDER_API_URL \
    NEXT_PUBLIC_NOTIFICATION_API_URL=$NEXT_PUBLIC_NOTIFICATION_API_URL \
    INTERNAL_AUTH_URL=$INTERNAL_AUTH_URL \
    INTERNAL_CATALOG_URL=$INTERNAL_CATALOG_URL \
    INTERNAL_CART_URL=$INTERNAL_CART_URL \
    INTERNAL_ORDER_URL=$INTERNAL_ORDER_URL \
    INTERNAL_NOTIFICATION_URL=$INTERNAL_NOTIFICATION_URL

# Build Next.js frontend
RUN npm run build --workspace=web

ENV NODE_ENV=production

EXPOSE 3000

CMD ["npm", "run", "start", "--workspace=web"]
